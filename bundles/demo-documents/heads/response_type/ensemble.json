{
 "spec": {
  "name": "response_type",
  "type": "choice",
  "classes": [
   "direct_answer",
   "extract_fields",
   "summarize",
   "compare",
   "list",
   "clarify_question",
   "escalate_human",
   "out_of_scope"
  ],
  "view": "query",
  "model": "logreg",
  "decision": "argmax",
  "stakes": "medium",
  "conformal": null,
  "description": "What kind of response does this request need? Judge the request itself, not whether the documents contain the answer: a question about a product that does not exist is still a direct_answer (the gatekeeper `answerable` catches it). Pick clarify_question only when the request does not name what it is about.",
  "input": {},
  "params": {},
  "levels": [
   "a short factual answer to one question (a price, a date, a name, a number)",
   "several named fields pulled out of the documents (e.g. SKU, price and warranty of one product)",
   "a summary or overview of a document, policy, product or team",
   "a comparison of two or more things (differences, which is cheaper / heavier / longer)",
   "an enumeration of all items that match (all products of a team, all teams of a department)",
   "the request is too ambiguous to answer (it does not say what it is about): ask a clarifying question",
   "a person must handle it: complaints, legal threats or questions, requests for personal data",
   "unrelated to the organisation's documents (weather, sports, recipes, general chit-chat)"
  ],
  "positive": null
 },
