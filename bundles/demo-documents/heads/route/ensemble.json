  "model": "logreg",
  "decision": "argmax",
  "stakes": "medium",
  "conformal": null,
  "description": "Which retrieval route should answer this request? vector for a single-document lookup, graph for multi-hop relations between entities, hybrid for comparisons and lists that gather several documents, none when no retrieval should run at all.",
  "input": {},
  "params": {},
  "levels": [
   "one passage of one document answers it (semantic / keyword lookup)",
   "the answer needs a chain of links across documents or entities (product -> owning team -> team lead)",
   "several documents must be gathered side by side (comparisons, lists across documents)",
   "no retrieval should run (clarify, escalate to a human, or out of scope)"
  ],
  "positive": null
 },
