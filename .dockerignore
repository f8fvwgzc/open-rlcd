# Everything is excluded, then the build inputs are listed: nothing local (a home with trained models, logged
# states, labels, keys) can reach the build context by accident.
*

!pyproject.toml
!uv.lock
!README.md
!LICENSE
!NOTICE
!open_rlcd/
!bundles/
bundles/*
!bundles/demo-documents/
!deploy/
deploy/*
!deploy/entrypoint.sh

# Explicit, in case the allow-list above is ever loosened.
var/
**/var/
.venv/
.git/
.github/
.claude/
START_HERE_PROMPT.md
.env
.env.*
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
**/.rlcd-cache/
**/embeddings-cache/
**/*.sqlite
**/*.sqlite3
**/*.onnx
**/*.npz
**/*.npy
dist/
build/
*.egg-info/
.coverage
htmlcov/
.DS_Store
tests/
examples/
docs/
